# Contoh penggunaan pustaka daftar (list).
impor "pustaka/daftar.idk"

fungsi kali_dua(x) { kembalikan x * 2 }
fungsi adalah_genap(x) { kembalikan x % 2 == 0 }
fungsi tambahkan(a, b) { kembalikan a + b }

cetak("=== peta (map) ===")
cetak(daftar_peta([1, 2, 3, 4], kali_dua))

cetak("=== saring (filter) ===")
cetak(daftar_saring([1, 2, 3, 4, 5, 6], adalah_genap))

cetak("=== lipat (reduce) ===")
cetak(daftar_lipat([1, 2, 3, 4, 5], 0, tambahkan))

cetak("=== berisi & indeks_dari ===")
cetak(daftar_berisi([10, 20, 30], 20))
cetak(daftar_indeks_dari([10, 20, 30], 30))
cetak(daftar_indeks_dari([10, 20, 30], 99))

cetak("=== iris & balik ===")
cetak(daftar_iris([1, 2, 3, 4, 5], 1, 4))
cetak(daftar_balik([1, 2, 3, 4]))

cetak("=== urutkan (angka & string) ===")
cetak(daftar_urutkan([5, 2, 8, 1, 9, 3]))
cetak(daftar_urutkan(["ceri", "apel", "mangga", "belimbing"]))
