# Regresi Fase 0: B10 (presisi cetak angka) dan B12 (cetak multi-argumen).

# cetak dengan banyak argumen: satu baris, dipisah spasi
cetak("a", 1, benar, kosong, [1, 2])
cetak()
cetak("setelah baris kosong")

# Angka dicetak dengan representasi terpendek yang tepat (seperti Python)
cetak(0.1 + 0.2)        # 0.30000000000000004
cetak(2 ** 0.5)         # 1.4142135623730951
cetak(1 / 3)            # 0.3333333333333333
cetak(0.5, 3.0, 10 / 4) # 0.5 3.0 2.5
cetak(2 ** 53)          # 9007199254740992 (bulat, tepat di atas 2^53)
cetak(2.0 ** 64)        # 1.8446744073709552e+19 (desimal: 2 ** 64 meluap)
cetak(0.00000015)       # 1.5e-07
cetak(-6 % 3)           # 0 (bukan -0)
cetak(ke_teks(0.1 + 0.2))
