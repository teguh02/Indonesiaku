# Literal kamus, indeks negatif, dan irisan.
# Kurung kurawal di posisi ekspresi adalah literal kamus; di posisi
# pernyataan tetap blok (lihat panduan sintaks).

# --- Literal kamus ---
variabel orang = {"nama": "Budi", "umur": 25}
cetak(orang["nama"], orang["umur"], panjang(orang))

variabel kosong_kamus = {}
cetak(panjang(kosong_kamus))

# Multi-baris dengan koma di akhir.
variabel sarang = {
    "angka": [1, 2, 3],
    "dalam": {"inti": "ya"},
}
cetak(sarang["angka"][1], sarang["dalam"]["inti"])

# Urutan penyisipan dipertahankan.
variabel urut = {"c": 3, "a": 1, "b": 2}
untuk k dalam urut {
    cetak(k, urut[k])
}

# Kunci duplikat: nilai terakhir menang, posisi tetap yang pertama.
variabel dobel = {"x": 1, "y": 2, "x": 9}
cetak(dobel["x"], panjang(dobel))

# --- Indeks negatif ---
variabel a = [10, 20, 30, 40, 50]
cetak(a[-1], a[-2], a[-5])
a[-1] = 99
cetak(a[4])
cetak("halo"[-1], "halo"[-4])

# --- Irisan daftar ---
cetak(a[1:3])
cetak(a[:2])
cetak(a[3:])
cetak(a[:])
cetak(a[::2])
cetak(a[::-1])
cetak(a[-3:-1])
cetak(a[1:100])
cetak(a[4:1])

# Irisan menghasilkan salinan dangkal.
variabel salinan = a[:]
salinan[0] = 777
cetak(a[0], salinan[0])

# --- Irisan teks ---
cetak("halo dunia"[0:4])
cetak("halo dunia"[-5:])
cetak("halo"[::-1])
cetak("halo"[1:3])
cetak("héllo"[1:3])

# Irisan juga bekerja di dalam fungsi (slot lokal hasil prescan).
fungsi ujung(xs) {
    depan = xs[:2]
    belakang = xs[-2:]
    kembalikan [depan, belakang]
}
variabel u = ujung([1, 2, 3, 4, 5])
cetak(u[0], u[1])
