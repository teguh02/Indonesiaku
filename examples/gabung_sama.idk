# Gabung (+), ulang (*), dan kesetaraan struktural (==).

# --- Gabung daftar ---
cetak([1, 2] + [3, 4])
cetak([] + [1])
cetak([1] + [])

variabel xs = [1, 2, 3, 4, 5]
cetak(xs[:2] + xs[-2:])

# Gabung menghasilkan daftar baru (sumber tidak berubah).
variabel asal = [1, 2]
variabel gabung = asal + [3]
gabung[0] = 99
cetak(asal[0], gabung[0], panjang(asal), panjang(gabung))

# Teks tetap seperti sebelumnya.
cetak("ha" + "lo")

# --- Ulang ---
cetak([0] * 3)
cetak(3 * [0])
cetak([1, 2] * 2)
cetak("-" * 5)
cetak("ab" * 2)
cetak(2 * "ab")

# Faktor nol atau negatif menghasilkan hasil kosong, seperti Python.
cetak([1] * 0, [1] * -3)
cetak(panjang("x" * 0))

# --- Kesetaraan struktural ---
cetak([1, 2] == [1, 2])
cetak([1, [2, 3]] == [1, [2, 3]])
cetak([1, 2] == [1, 3], [1] == [1, 2], [] == [])
cetak({"a": 1} == {"a": 1})

# Urutan penyisipan tidak memengaruhi kesetaraan kamus.
cetak({"a": 1, "b": 2} == {"b": 2, "a": 1})
cetak({"a": 1} == {"a": 2}, {"a": 1} == {"b": 1})

cetak(rentang(3) == rentang(3), rentang(3) == rentang(4))

# Tipe berbeda tidak pernah sama.
cetak([1, 2] == "ab", [1] == 1, kosong == kosong)

# --- 'adalah' tetap identitas ---
variabel x = [1, 2]
variabel y = [1, 2]
variabel z = x
cetak(x == y, x adalah y)
cetak(x adalah x, x adalah z)
cetak(x bukan adalah y)

# --- 'dalam' ikut memakai kesetaraan struktural ---
cetak([1, 2] dalam [[1, 2], [3]])
cetak({"a": 1} dalam [{"a": 1}])
cetak([9] dalam [[1, 2]])

# --- Instansi kelas tetap identitas ---
kelas Titik {
    init(n) {
        diri.n = n
    }
}
variabel p1 = Titik(1)
variabel p2 = Titik(1)
cetak(p1 == p2, p1 == p1)
