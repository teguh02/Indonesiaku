{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Indonesiaku",
  "scopeName": "source.indonesiaku",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.indonesiaku",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.indonesiaku",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.indonesiaku",
              "match": "\\\\[ntr\\\"'\\\\]"
            }
          ]
        },
        {
          "name": "string.interpolated.indonesiaku",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.indonesiaku",
              "match": "\\\\[ntr\\\"'\\\\]"
            },
            {
              "name": "meta.embedded.indonesiaku",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.indonesiaku",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.indonesiaku",
              "match": "\\\\[ntr\\\"'\\\\]"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.indonesiaku",
          "match": "\\b(?:adalah|akhirnya|atau|buang|bukan|cocokkan|coba|dalam|dan|dari|dengan|fungsi|global|hasilkan|hentikan|impor|jika(?:_lain)?|kasus|kecuali|kelas|kembalikan|lanjut|lewati|naikkan|nonlokal|pastikan|sebagai|selagi|selain|super|tidak|untuk|variabel)\\b"
        },
        {
          "name": "keyword.other.indonesiaku",
          "match": "\\b(?:diri)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.indonesiaku",
          "match": "\\b(?:benar|salah|kosong)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.magic.indonesiaku",
          "match": "\\b_(?:kurang_sama|kbagi_bulat|kurang_dari|tidak_sama|lebih_dari|lebih_sama|bagi_bulat|kkurangi|kpangkat|panjang|ktambah|kurangi|negatif|pangkat|tambah|logika|kkali|kbagi|ksisa|ambil|atur|bagi|berikutnya|sama|hash|sisa|repr|kali|teks|iter|panggil|masuk|keluar)_\\b"
        },
        {
          "name": "support.function.builtin.indonesiaku",
          "match": "\\b(?:db_baris_terpengaruh|ambil_lingkungan|adalah_instansi|hapus_direktori|bisa_dipanggil|buat_direktori|db_ambil_semua|db_id_terakhir|direktori_kini|format_tanggal|ambil_atribut|db_ambil_satu|himpunan_beku|isi_direktori|punya_atribut|tambah_berkas|atur_atribut|hapus_berkas|soket_dengar|soket_terima|turunan_dari|buka_berkas|db_eksekusi|hapus_kunci|huruf_besar|huruf_kecil|soket_tulis|soket_tutup|tulis_galat|tulis_semua|acak_bulat|ada_berkas|baca_baris|baca_semua|hapus_pada|jalur_indk|ke_desimal|lingkungan|soket_baca|bagi_sisa|enumerasi|ke_logika|lanjutkan|pasangkan|ada_yang|bulatkan|db_batal|db_komit|db_mulai|db_tutup|himpunan|karakter|ke_angka|ke_bulat|terbalik|db_buka|ke_teks|pangkat|panjang|rentang|tanggal|terurut|daftar|format|jumlah|keluar|lantai|potong|saring|sha256|sha512|tambah|biner|bulat|cetak|ganti|hapus|heksa|henti|input|jenis|kamus|kunci|oktal|punya|semua|sisip|tulis|tupel|tutup|waktu|acak|akar|atap|baca|hash|iter|peta|repr|sha1|abs|chr|jam|max|md5|min|ord|id)\\b"
        },
        {
          "name": "entity.name.function.indonesiaku",
          "match": "(?<=\\bfungsi\\s)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.indonesiaku",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.[\\d_]+)?(?:[eE][+-]?\\d[\\d_]*)?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.indonesiaku",
          "match": "(?:<<=|>>=|==|!=|<=|>=|//=|\\*\\*=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|//|\\*\\*|[+*/%<>=!&|^~])"
        }
      ]
    }
  }
}
