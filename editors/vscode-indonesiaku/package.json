{
  "name": "indonesiaku",
  "displayName": "Indonesiaku",
  "description": "Language support for Indonesiaku (.idk): syntax highlighting, LSP diagnostics, completion, hover, go-to-definition, snippets, and formatting.",
  "version": "0.2.0",
  "publisher": "teguh02",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "indonesiaku",
    "indk",
    "bahasa indonesia",
    "programming language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/teguh02/Indonesiaku.git"
  },
  "main": "./extension.js",
  "files": [
    "extension.js",
    "server.js",
    "language-data.js",
    "language-configuration.json",
    "syntaxes",
    "snippets",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onLanguage:indonesiaku"
  ],
  "contributes": {
    "languages": [
      {
        "id": "indonesiaku",
        "aliases": [
          "Indonesiaku",
          "indk"
        ],
        "extensions": [
          ".idk",
          ".indk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "indonesiaku",
        "scopeName": "source.indonesiaku",
        "path": "./syntaxes/indonesiaku.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "indonesiaku",
        "path": "./snippets/indonesiaku.code-snippets"
      }
    ],
    "configuration": {
      "title": "Indonesiaku",
      "properties": {
        "indonesiaku.jalurIndk": {
          "type": "string",
          "default": "indk",
          "description": "Jalur ke interpreter indk yang dipakai untuk Format Document (indk rapikan)."
        }
      }
    }
  },
  "scripts": {
    "test:lsp": "node test-lsp.js",
    "test:format": "node test-format.js",
    "package": "npx @vscode/vsce package"
  }
}
