{
  "Fungsi": {
    "prefix": "fungsi",
    "body": [
      "fungsi ${1:nama}(${2:argumen}) {",
      "    ${0}",
      "}"
    ],
    "description": "Buat fungsi Indonesiaku"
  },
  "Jika": {
    "prefix": "jika",
    "body": [
      "jika ${1:kondisi} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat percabangan jika"
  },
  "Jika-lain": {
    "prefix": "jika_lain",
    "body": [
      "jika ${1:kondisi} {",
      "    ${2}",
      "} jika_lain ${3:kondisi_lain} {",
      "    ${0}",
      "} selain {",
      "    ${4}",
      "}"
    ],
    "description": "Buat jika, jika_lain, dan selain"
  },
  "Selagi": {
    "prefix": "selagi",
    "body": [
      "selagi ${1:kondisi} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat perulangan selagi"
  },
  "Untuk dalam": {
    "prefix": "untuk",
    "body": [
      "untuk ${1:item} dalam ${2:daftar} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat perulangan untuk ... dalam"
  },
  "Kelas": {
    "prefix": "kelas",
    "body": [
      "kelas ${1:NamaKelas} {",
      "    init(${2:argumen}) {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Buat kelas dengan konstruktor"
  },
  "Coba kecuali": {
    "prefix": "coba",
    "body": [
      "coba {",
      "    ${1}",
      "} kecuali ${2:galat} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat penanganan kesalahan"
  },
  "Impor pustaka": {
    "prefix": "impor",
    "body": [
      "impor \"pustaka/${1:modul}.idk\"",
      "${0}"
    ],
    "description": "Impor pustaka standar"
  },
  "Cetak": {
    "prefix": "cetak",
    "body": "cetak(${0})",
    "description": "Cetak nilai"
  },
  "Kamus literal": {
    "prefix": "kamus",
    "body": [
      "{\"${1:kunci}\": ${2:nilai}}${0}"
    ],
    "description": "Literal kamus Indonesiaku (kunci harus teks)"
  },
  "Irisan": {
    "prefix": "irisan",
    "body": [
      "${1:daftar}[${2:awal}:${3:akhir}]${0}"
    ],
    "description": "Irisan daftar/teks a[awal:akhir]"
  },
  "Fungsi dengan nilai bawaan": {
    "prefix": "fungsibawaan",
    "body": [
      "fungsi ${1:nama}(${2:wajib}, ${3:opsional}=${4:nilai}) {",
      "\t$0",
      "}"
    ],
    "description": "Fungsi dengan parameter bernilai bawaan (dievaluasi tiap panggilan)"
  },
  "Panggil dengan argumen bernama": {
    "prefix": "panggilbernama",
    "body": [
      "${1:fungsi}(${2:nilai}, ${3:parameter}=${4:nilai})$0"
    ],
    "description": "Panggilan dengan argumen bernama; posisional harus mendahului yang bernama"
  },
  "Buka basis data SQLite": {
    "prefix": "dbbuka",
    "body": [
      "variabel ${1:db} = db_buka(\"${2::memory:}\")",
      "$0",
      "db_tutup(${1:db})"
    ],
    "description": "Buka basis data SQLite dan tutup kembali"
  },
  "Kueri SQLite dengan parameter": {
    "prefix": "dbkueri",
    "body": [
      "untuk ${1:baris} dalam db_ambil_semua(${2:db}, \"SELECT ${3:*} FROM ${4:tabel} WHERE ${5:kolom} = ?\", [${6:nilai}]) {",
      "\t$0",
      "}"
    ],
    "description": "Kueri SQLite dengan parameter '?' (jangan merangkai SQL dengan +)"
  },
  "Transaksi SQLite": {
    "prefix": "dbtransaksi",
    "body": [
      "db_mulai(${1:db})",
      "coba {",
      "\t$0",
      "\tdb_komit(${1:db})",
      "} kecuali Galat sebagai e {",
      "\tdb_batal(${1:db})",
      "}"
    ],
    "description": "Transaksi SQLite dengan rollback saat galat"
  }
}
