{
  "List comprehension": {
    "prefix": "komprehensi",
    "body": [
      "[${1:ekspresi} untuk ${2:x} dalam ${3:urutan} jika ${4:syarat}]"
    ],
    "description": "List comprehension Indonesiaku"
  },
  "Penugasan berganda": {
    "prefix": "unpack",
    "body": [
      "${1:a}, ${2:b} = ${3:urutan}"
    ],
    "description": "Buka beberapa nilai sekaligus"
  },
  "Fungsi": {
    "prefix": "fungsi",
    "body": [
      "fungsi ${1:nama}(${2:argumen}) {",
      "    ${0}",
      "}"
    ],
    "description": "Buat fungsi Indonesiaku"
  },
  "Jika": {
    "prefix": "jika",
    "body": [
      "jika ${1:kondisi} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat percabangan jika"
  },
  "Jika-lain": {
    "prefix": "jika_lain",
    "body": [
      "jika ${1:kondisi} {",
      "    ${2}",
      "} jika_lain ${3:kondisi_lain} {",
      "    ${0}",
      "} selain {",
      "    ${4}",
      "}"
    ],
    "description": "Buat jika, jika_lain, dan selain"
  },
  "Selagi": {
    "prefix": "selagi",
    "body": [
      "selagi ${1:kondisi} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat perulangan selagi"
  },
  "Untuk dalam": {
    "prefix": "untuk",
    "body": [
      "untuk ${1:item} dalam ${2:daftar} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat perulangan untuk ... dalam"
  },
  "Kelas": {
    "prefix": "kelas",
    "body": [
      "kelas ${1:NamaKelas} {",
      "    init(${2:argumen}) {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Buat kelas dengan konstruktor"
  },
  "Coba kecuali": {
    "prefix": "coba",
    "body": [
      "coba {",
      "    ${1}",
      "} kecuali ${2:galat} {",
      "    ${0}",
      "}"
    ],
    "description": "Buat penanganan kesalahan"
  },
  "Impor pustaka": {
    "prefix": "impor",
    "body": [
      "impor \"pustaka/${1:modul}.idk\"",
      "${0}"
    ],
    "description": "Impor pustaka standar"
  },
  "Cetak": {
    "prefix": "cetak",
    "body": "cetak(${0})",
    "description": "Cetak nilai"
  },
  "Kamus literal": {
    "prefix": "kamus",
    "body": [
      "{\"${1:kunci}\": ${2:nilai}}${0}"
    ],
    "description": "Literal kamus Indonesiaku (kunci harus teks)"
  },
  "Irisan": {
    "prefix": "irisan",
    "body": [
      "${1:daftar}[${2:awal}:${3:akhir}]${0}"
    ],
    "description": "Irisan daftar/teks a[awal:akhir]"
  },
  "Fungsi dengan nilai bawaan": {
    "prefix": "fungsibawaan",
    "body": [
      "fungsi ${1:nama}(${2:wajib}, ${3:opsional}=${4:nilai}) {",
      "\t$0",
      "}"
    ],
    "description": "Fungsi dengan parameter bernilai bawaan (dievaluasi tiap panggilan)"
  },
  "Panggil dengan argumen bernama": {
    "prefix": "panggilbernama",
    "body": [
      "${1:fungsi}(${2:nilai}, ${3:parameter}=${4:nilai})$0"
    ],
    "description": "Panggilan dengan argumen bernama; posisional harus mendahului yang bernama"
  },
  "f-string": {
    "prefix": "fstring",
    "body": [
      "f\"${1:teks} {${2:ekspresi}}\"$0"
    ],
    "description": "Teks dengan ekspresi tersisip"
  },
  "String tiga kutip": {
    "prefix": "tigakutip",
    "body": [
      "\"\"\"${1:baris pertama}",
      "${2:baris kedua}\"\"\"$0"
    ],
    "description": "Teks multi-baris"
  },
  "Fungsi anonim": {
    "prefix": "fungsianonim",
    "body": [
      "fungsi(${1:x}) { kembalikan ${2:x} }$0"
    ],
    "description": "Fungsi tanpa nama sebagai nilai (closure)"
  },
  "Ekspresi kondisional": {
    "prefix": "jikaselain",
    "body": [
      "${1:nilai_benar} jika ${2:kondisi} selain ${3:nilai_salah}$0"
    ],
    "description": "Pilih satu dari dua nilai dalam satu ekspresi"
  },
  "Penegasan (assert)": {
    "prefix": "pastikan",
    "body": [
      "pastikan ${1:kondisi}, \"${2:pesan}\"$0"
    ],
    "description": "Nyatakan kondisi yang harus benar; gagal -> GalatPenegasan"
  },
  "Buka basis data SQLite": {
    "prefix": "dbbuka",
    "body": [
      "variabel ${1:db} = db_buka(\"${2::memory:}\")",
      "$0",
      "db_tutup(${1:db})"
    ],
    "description": "Buka basis data SQLite dan tutup kembali"
  },
  "Kueri SQLite dengan parameter": {
    "prefix": "dbkueri",
    "body": [
      "untuk ${1:baris} dalam db_ambil_semua(${2:db}, \"SELECT ${3:*} FROM ${4:tabel} WHERE ${5:kolom} = ?\", [${6:nilai}]) {",
      "\t$0",
      "}"
    ],
    "description": "Kueri SQLite dengan parameter '?' (jangan merangkai SQL dengan +)"
  },
  "Transaksi SQLite": {
    "prefix": "dbtransaksi",
    "body": [
      "db_mulai(${1:db})",
      "coba {",
      "\t$0",
      "\tdb_komit(${1:db})",
      "} kecuali Galat sebagai e {",
      "\tdb_batal(${1:db})",
      "}"
    ],
    "description": "Transaksi SQLite dengan rollback saat galat"
  },
  "Tupel tanpa kurung": {
    "prefix": "tupel",
    "body": [
      "${1:x} = ${2:1}, ${3:2}"
    ],
    "description": "Tupel tanpa kurung pada sisi kanan penugasan"
  },
  "Kembalikan beberapa nilai": {
    "prefix": "kembalikan2",
    "body": [
      "kembalikan ${1:a}, ${2:b}"
    ],
    "description": "Kembalikan beberapa nilai sebagai tupel"
  },
  "Himpunan beku": {
    "prefix": "himpunanbeku",
    "body": [
      "${1:nama} = himpunan_beku([${2:1, 2}])"
    ],
    "description": "Himpunan yang dapat di-hash (bisa jadi kunci kamus)"
  },
  "Iterator": {
    "prefix": "iter",
    "body": [
      "${1:it} = iter(${2:urutan})",
      "cetak(lanjutkan($1, ${3:\"habis\"}))"
    ],
    "description": "Iterator eksplisit dengan iter() dan lanjutkan()"
  }
}
