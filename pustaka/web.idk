# pustaka/web.idk - Modul server HTTP (routing + middleware).
#
# Pemakaian:
#     impor web
#     variabel app = web.Aplikasi()
#     app.rute("GET", "/todos/:id", fungsi(req) { ... })
#     variabel respons = app.tangani(mentah)
#
# app.tangani() bekerja pada TEKS request dan mengembalikan TEKS respons,
# tidak menyentuh soket. Dengan begitu server dapat diuji tanpa jaringan,
# dan gelung soket yang sudah ada tetap dipakai apa adanya.

impor "pustaka/teks.idk"
impor "pustaka/http.idk"
impor "pustaka/json.idk"

kelas GalatWeb < Galat {
    init(pesan) { diri.pesan = pesan }
}

# _web_nilai_heks(c) -> 0..15, atau -1 bila bukan digit heksadesimal.
fungsi _web_nilai_heks(c) {
    jika c >= "0" dan c <= "9" { kembalikan ord(c) - 48 }
    jika c >= "a" dan c <= "f" { kembalikan ord(c) - 87 }
    jika c >= "A" dan c <= "F" { kembalikan ord(c) - 55 }
    kembalikan 0 - 1
}

# _web_dekode_persen(t) -> teks dengan %XX dan + didekode.
# Urutan % yang tidak sah dibiarkan apa adanya: menolak seluruh permintaan
# karena satu karakter aneh lebih merugikan daripada meneruskannya.
fungsi _web_dekode_persen(t) {
    variabel hasil = ""
    variabel i = 0
    variabel n = panjang(t)
    selagi i < n {
        variabel c = t[i]
        jika c == "+" {
            hasil = hasil + " "
            i = i + 1
        } jika_lain c == "%" dan i + 2 < n {
            variabel tinggi = _web_nilai_heks(t[i + 1])
            variabel rendah = _web_nilai_heks(t[i + 2])
            jika tinggi == 0 - 1 atau rendah == 0 - 1 {
                hasil = hasil + c
                i = i + 1
            } selain {
                hasil = hasil + chr(tinggi * 16 + rendah)
                i = i + 3
            }
        } selain {
            hasil = hasil + c
            i = i + 1
        }
    }
    kembalikan hasil
}

# _web_urai_query(q) -> kamus. Kunci berulang: yang terakhir menang.
fungsi _web_urai_query(q) {
    variabel hasil = kamus()
    jika q == "" {
        kembalikan hasil
    }
    untuk bagian dalam teks_pisah(q, "&") {
        jika bagian != "" {
            variabel sama = teks_cari(bagian, "=")
            jika sama == 0 - 1 {
                hasil[_web_dekode_persen(bagian)] = ""
            } selain {
                variabel nama = potong(bagian, 0, sama)
                variabel nilai = potong(bagian, sama + 1, panjang(bagian) - sama - 1)
                hasil[_web_dekode_persen(nama)] = _web_dekode_persen(nilai)
            }
        }
    }
    kembalikan hasil
}

# _web_tipe_dasar(ct) -> bagian Content-Type sebelum ';', huruf kecil.
# "application/json; charset=utf-8" -> "application/json"
fungsi _web_tipe_dasar(ct) {
    variabel titik_koma = teks_cari(ct, ";")
    jika titik_koma != 0 - 1 {
        ct = potong(ct, 0, titik_koma)
    }
    kembalikan huruf_kecil(teks_pangkas(ct))
}

# _web_param_tipe(ct, nama) -> nilai parameter Content-Type, "" bila tiada.
# Mengambil boundary dari "multipart/form-data; boundary=----abc".
# Tanda kutip di sekeliling nilai dibuang; RFC 2046 mengizinkan keduanya.
fungsi _web_param_tipe(ct, nama) {
    untuk bagian dalam teks_pisah(ct, ";") {
        variabel b = teks_pangkas(bagian)
        variabel sama = teks_cari(b, "=")
        jika sama != 0 - 1 {
            variabel k = huruf_kecil(teks_pangkas(potong(b, 0, sama)))
            jika k == nama {
                variabel v = teks_pangkas(potong(b, sama + 1, panjang(b) - sama - 1))
                jika panjang(v) >= 2 dan v[0] == "\"" dan v[panjang(v) - 1] == "\"" {
                    v = potong(v, 1, panjang(v) - 2)
                }
                kembalikan v
            }
        }
    }
    kembalikan ""
}

# _web_urai_multipart(badan, boundary) -> [form, berkas].
# Bagian dengan filename= masuk ke berkas, sisanya ke form.
fungsi _web_urai_multipart(badan, boundary) {
    variabel form = kamus()
    variabel berkas = kamus()
    variabel pemisah = "--" + boundary
    untuk bagian dalam teks_pisah(badan, pemisah) {
        # Bagian pertama kosong, bagian terakhir "--\r\n"; keduanya dilewati.
        variabel kosong_batas = teks_pangkas(bagian)
        jika kosong_batas != "" dan kosong_batas != "--" {
            variabel batas = teks_cari(bagian, "\r\n\r\n")
            jika batas != 0 - 1 {
                variabel kepala = potong(bagian, 0, batas)
                variabel isi = potong(bagian, batas + 4, panjang(bagian) - batas - 4)
                # Setiap bagian diakhiri CRLF sebelum pemisah berikutnya.
                jika panjang(isi) >= 2 dan potong(isi, panjang(isi) - 2, 2) == "\r\n" {
                    isi = potong(isi, 0, panjang(isi) - 2)
                }
                variabel nama = ""
                variabel nama_berkas = ""
                untuk baris dalam teks_pisah(kepala, "\r\n") {
                    jika huruf_kecil(potong(teks_pangkas(baris), 0, 19)) == "content-disposition" {
                        nama = _web_param_tipe(baris, "name")
                        nama_berkas = _web_param_tipe(baris, "filename")
                    }
                }
                jika nama != "" {
                    jika nama_berkas == "" {
                        form[nama] = isi
                    } selain {
                        variabel b = kamus()
                        b["nama_berkas"] = nama_berkas
                        b["isi"] = isi
                        berkas[nama] = b
                    }
                }
            }
        }
    }
    kembalikan [form, berkas]
}

# baca_permintaan(klien) -> teks permintaan HTTP UTUH.
#
# soket_baca() mengembalikan apa pun yang sudah tiba (maks ~64KB per
# panggilan), jadi memanggilnya SEKALI memotong badan besar diam-diam.
# Fungsi ini membaca sampai header lengkap, lalu terus membaca sampai
# Content-Length terpenuhi.
#
# maks_badan membatasi badan yang dikumpulkan; "" dikembalikan bila klien
# menutup koneksi sebelum apa pun tiba.

# _web_panjang_bita(t) -> jumlah byte UTF-8 dari teks t.
#
# panjang() menghitung KARAKTER, sedangkan Content-Length menghitung BYTE.
# Untuk badan ber-UTF-8 keduanya berbeda ("☕" = 1 karakter, 3 byte), dan
# gelung yang menunggu `panjang(badan) >= Content-Length` akan menunggu byte
# yang tidak akan pernah datang -- server menggantung selamanya.
fungsi _web_panjang_bita(t) {
    variabel n = 0
    untuk c dalam t {
        variabel k = ord(c)
        jika k < 128 {
            n = n + 1
        } jika_lain k < 2048 {
            n = n + 2
        } jika_lain k < 65536 {
            n = n + 3
        } selain {
            n = n + 4
        }
    }
    kembalikan n
}

fungsi baca_permintaan(klien, maks_badan = 1048576) {
    variabel buf = soket_baca(klien)
    jika buf == "" {
        kembalikan ""
    }
    # Kumpulkan sampai akhir header terlihat.
    variabel batas = teks_cari(buf, "\r\n\r\n")
    selagi batas == 0 - 1 {
        variabel potongan = soket_baca(klien)
        jika potongan == "" {
            kembalikan buf
        }
        buf = buf + potongan
        batas = teks_cari(buf, "\r\n\r\n")
    }

    # Content-Length menentukan sisa yang harus dibaca. Header dicari dalam
    # bentuk huruf kecil karena nama header case-insensitive.
    variabel kepala = huruf_kecil(potong(buf, 0, batas))
    variabel cl = 0 - 1
    untuk baris dalam teks_pisah(kepala, "\r\n") {
        jika potong(baris, 0, 15) == "content-length:" {
            variabel angka = teks_pangkas(potong(baris, 15, panjang(baris) - 15))
            cl = ke_bulat(angka)
        }
    }
    jika cl <= 0 {
        kembalikan buf
    }
    # Tolak lebih awal: jangan kumpulkan badan raksasa hanya untuk menolaknya.
    jika cl > maks_badan {
        kembalikan buf
    }
    # Dibandingkan dalam BYTE. Dihitung inkremental: menghitung ulang seluruh
    # badan tiap putaran membuat unggahan besar jadi O(n^2).
    variabel terkumpul = _web_panjang_bita(potong(buf, batas + 4, panjang(buf) - (batas + 4)))
    selagi terkumpul < cl {
        variabel sisa = soket_baca(klien)
        jika sisa == "" {
            kembalikan buf
        }
        buf = buf + sisa
        terkumpul = terkumpul + _web_panjang_bita(sisa)
    }
    kembalikan buf
}

# _web_segmen(path) -> daftar segmen tanpa yang kosong.
fungsi _web_segmen(path) {
    variabel hasil = []
    untuk s dalam teks_pisah(path, "/") {
        jika s != "" {
            tambah(hasil, s)
        }
    }
    kembalikan hasil
}

# _web_cocok(pola, path) -> kamus params bila cocok, atau kosong.
# Segmen :nama cocok dengan SATU segmen. Jumlah segmen harus sama persis,
# jadi /a/:b tidak cocok dengan /a/b/c.
fungsi _web_cocok(pola, path) {
    variabel p = _web_segmen(pola)
    variabel j = _web_segmen(path)
    jika panjang(p) != panjang(j) {
        kembalikan kosong
    }
    variabel params = kamus()
    variabel i = 0
    selagi i < panjang(p) {
        variabel seg = p[i]
        jika panjang(seg) > 1 dan seg[0] == ":" {
            params[potong(seg, 1, panjang(seg) - 1)] = _web_dekode_persen(j[i])
        } jika_lain seg != j[i] {
            kembalikan kosong
        }
        i = i + 1
    }
    kembalikan params
}

# json(kode, teks_json) -> teks respons HTTP.
fungsi json(kode, badan) {
    kembalikan http_response_json(kode, badan)
}

# teks(kode, isi) -> teks respons HTTP text/plain.
fungsi teks(kode, isi) {
    kembalikan http_response(kode, "text/plain; charset=utf-8", isi)
}

# html(kode, isi) -> teks respons HTTP text/html.
fungsi html(kode, isi) {
    kembalikan http_response(kode, "text/html; charset=utf-8", isi)
}

kelas Aplikasi {
    init(maks_badan = 1048576) {
        diri.rute_daftar = []        # [metode, pola, penangan]
        diri.middleware = []
        diri.penangan_galat = kosong
        # Badan request dibatasi supaya satu klien tidak bisa menghabiskan
        # memori server. 1 MB cukup untuk form dan API; naikkan bila perlu.
        jika ke_bulat(maks_badan) <= 0 {
            naikkan GalatWeb("maks_badan harus bulat positif")
        }
        diri.maks_badan = ke_bulat(maks_badan)
    }

    # rute(metode, pola, penangan) -> diri (bisa dirantai).
    # penangan(req) harus mengembalikan teks respons HTTP.
    rute(metode, pola, penangan) {
        jika jenis(pola) != "teks" atau pola == "" atau pola[0] != "/" {
            naikkan GalatWeb("pola rute harus teks yang diawali '/'")
        }
        jika tidak bisa_dipanggil(penangan) {
            naikkan GalatWeb("penangan rute harus bisa dipanggil")
        }
        tambah(diri.rute_daftar, [huruf_besar(metode), pola, penangan])
        kembalikan diri
    }

    # gunakan(mw) -> diri. mw(req, teruskan); panggil teruskan(req) untuk
    # meneruskan, atau kembalikan respons untuk menghentikan rantai.
    gunakan(mw) {
        jika tidak bisa_dipanggil(mw) {
            naikkan GalatWeb("middleware harus bisa dipanggil")
        }
        tambah(diri.middleware, mw)
        kembalikan diri
    }

    # galat(penangan) -> diri. penangan(req, e) menimpa respons 500 bawaan.
    galat(penangan) {
        jika tidak bisa_dipanggil(penangan) {
            naikkan GalatWeb("penangan galat harus bisa dipanggil")
        }
        diri.penangan_galat = penangan
        kembalikan diri
    }

    # _cari(req) -> teks respons.
    _cari(req) {
        variabel metode = req["metode"]
        variabel path = req["path"]
        variabel metode_lain = []
        untuk r dalam diri.rute_daftar {
            variabel params = _web_cocok(r[1], path)
            jika params bukan adalah kosong {
                jika r[0] == metode {
                    req["params"] = params
                    kembalikan r[2](req)
                }
                jika tidak r[0] dalam metode_lain {
                    tambah(metode_lain, r[0])
                }
            }
        }
        # Path cocok tapi metode tidak: 405, bukan 404. Membedakan
        # "tidak ada" dari "metode salah" sangat membantu saat debug.
        jika panjang(metode_lain) > 0 {
            variabel izin = teks_gabung(metode_lain, ", ")
            variabel badan = "Metode tidak boleh"
            variabel kepala = "HTTP/1.1 405 Method Not Allowed\r\nAllow: " + izin
            kepala = kepala + "\r\nContent-Type: text/plain; charset=utf-8"
            kepala = kepala + "\r\nContent-Length: " + ke_teks(_http_panjang_byte(badan))
            kepala = kepala + "\r\nConnection: close\r\n\r\n"
            kembalikan kepala + badan
        }
        kembalikan teks(404, "Tidak ditemukan")
    }

    # tangani(mentah) -> teks respons HTTP untuk satu request mentah.
    tangani(mentah) {
        variabel req = kosong
        coba {
            req = http_urai_request(mentah)
        } kecuali Galat sebagai e {
            kembalikan teks(400, "Permintaan tidak sah")
        }
        jika req["metode"] == "" {
            kembalikan teks(400, "Permintaan tidak sah")
        }
        # Parser hanya memisah baris pertama per spasi, jadi "bukan http sama
        # sekali" lolos sebagai metode/path/versi. Path HTTP yang sah selalu
        # diawali "/" (bentuk absolut dan CONNECT tidak didukung di sini).
        jika panjang(req["path"]) == 0 atau req["path"][0] != "/" {
            kembalikan teks(400, "Permintaan tidak sah")
        }

        # Pisahkan query dari path.
        variabel path = req["path"]
        variabel tanya = teks_cari(path, "?")
        jika tanya == 0 - 1 {
            req["query"] = kamus()
        } selain {
            req["query"] = _web_urai_query(potong(path, tanya + 1, panjang(path) - tanya - 1))
            req["path"] = potong(path, 0, tanya)
        }
        req["params"] = kamus()

        # Badan: urai sesuai Content-Type. Ketiga kunci SELALU ada supaya
        # penangan tidak perlu memeriksa keberadaan kunci lebih dulu.
        req["form"] = kamus()
        req["berkas"] = kamus()
        req["json"] = kosong

        variabel ct = ""
        jika "content-type" dalam req["header"] {
            ct = req["header"]["content-type"]
        }

        # Transfer-Encoding: chunked tidak didukung. Menolak terang-terangan
        # lebih aman daripada diam-diam memperlakukan ukuran chunk sebagai
        # data badan.
        jika "transfer-encoding" dalam req["header"] {
            jika huruf_kecil(req["header"]["transfer-encoding"]) == "chunked" {
                kembalikan teks(411, "Transfer-Encoding chunked tidak didukung")
            }
        }

        # Batas ukuran diperiksa dari Content-Length, bukan dari badan yang
        # sudah terkumpul: baca_permintaan() sengaja berhenti lebih awal.
        jika "content-length" dalam req["header"] {
            variabel cl = 0 - 1
            coba {
                cl = ke_bulat(teks_pangkas(req["header"]["content-length"]))
            } kecuali e {
                kembalikan teks(400, "Content-Length tidak sah")
            }
            jika cl < 0 {
                kembalikan teks(400, "Content-Length tidak sah")
            }
            jika cl > diri.maks_badan {
                kembalikan teks(413, "Badan permintaan terlalu besar")
            }
        }

        variabel dasar = _web_tipe_dasar(ct)
        jika panjang(req["badan"]) > 0 {
            jika dasar == "application/x-www-form-urlencoded" {
                req["form"] = _web_urai_query(req["badan"])
            } jika_lain dasar == "application/json" {
                coba {
                    req["json"] = json_urai(req["badan"])
                } kecuali e {
                    # JSON rusak adalah kesalahan KLIEN, bukan 500.
                    # Catch-all: json_urai menaikkan TEKS mentah, bukan
                    # instance Galat, jadi "kecuali Galat" tidak menangkapnya.
                    kembalikan teks(400, "JSON tidak sah")
                }
            } jika_lain dasar == "multipart/form-data" {
                variabel boundary = _web_param_tipe(ct, "boundary")
                jika boundary == "" {
                    kembalikan teks(400, "multipart tanpa boundary")
                }
                variabel pasangan = _web_urai_multipart(req["badan"], boundary)
                req["form"] = pasangan[0]
                req["berkas"] = pasangan[1]
            }
        }

        coba {
            kembalikan diri._jalankan(req, 0)
        } kecuali Galat sebagai e {
            jika diri.penangan_galat bukan adalah kosong {
                kembalikan diri.penangan_galat(req, e)
            }
            # Detail galat TIDAK bocor ke klien; operator melihatnya di stderr.
            tulis_galat("web: galat menangani " + req["metode"] + " "
                        + req["path"] + ": " + ke_teks(e))
            kembalikan teks(500, "Galat internal")
        }
    }

    # _jalankan(req, i) -> jalankan middleware ke-i lalu seterusnya.
    _jalankan(req, i) {
        jika i >= panjang(diri.middleware) {
            kembalikan diri._cari(req)
        }
        variabel app = diri
        variabel berikut = i + 1
        kembalikan diri.middleware[i](req, fungsi(r) {
            kembalikan app._jalankan(r, berikut)
        })
    }
}
