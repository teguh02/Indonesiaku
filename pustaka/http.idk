# pustaka/http.idk - Parsing request & pembuatan response HTTP sederhana.
# Impor: impor "pustaka/http.idk"  (butuh pustaka/teks.idk)
#
# http_urai_request(teks) -> kamus {metode, path, versi, header, badan}
# http_response(kode, tipe_konten, badan) -> string response HTTP lengkap
# http_ambil(url, metode, kepala, badan) -> Respons   (klien, http:// saja)
#
# Dengan `impor http` (bernamespace) semua ini menjadi http.http_ambil, dst.

impor "pustaka/teks.idk"

# Pisahkan header "Nama: nilai" menjadi list [nama, nilai].
fungsi _http_pisah_header(baris) {
    variabel i = teks_cari(baris, ":")
    jika i == 0 - 1 {
        kembalikan ["", ""]
    }
    variabel nama = potong(baris, 0, i)
    variabel nilai = teks_pangkas(potong(baris, i + 1, panjang(baris) - i - 1))
    kembalikan [nama, nilai]
}

# Urai request HTTP mentah menjadi kamus komponen.
fungsi http_urai_request(teks) {
    variabel hasil = kamus()
    hasil["metode"] = ""
    hasil["path"] = ""
    hasil["versi"] = ""
    hasil["header"] = kamus()
    hasil["badan"] = ""

    # Pisahkan header dari badan pada baris kosong pertama (\r\n\r\n).
    variabel pemisah = teks_cari(teks, "\r\n\r\n")
    variabel bagian_header = teks
    jika pemisah != 0 - 1 {
        bagian_header = potong(teks, 0, pemisah)
        hasil["badan"] = potong(teks, pemisah + 4, panjang(teks) - pemisah - 4)
    }

    variabel baris = teks_pisah(bagian_header, "\r\n")
    jika panjang(baris) == 0 {
        kembalikan hasil
    }

    # Baris pertama: "METODE /path HTTP/1.1"
    variabel awal = teks_pisah(baris[0], " ")
    jika panjang(awal) >= 3 {
        hasil["metode"] = awal[0]
        hasil["path"] = awal[1]
        hasil["versi"] = awal[2]
    }

    # Sisa baris: header.
    variabel i = 1
    selagi i < panjang(baris) {
        jika panjang(baris[i]) > 0 {
            variabel h = _http_pisah_header(baris[i])
            jika h[0] != "" {
                hasil["header"][huruf_kecil(h[0])] = h[1]
            }
        }
        i = i + 1
    }

    kembalikan hasil
}

# Frasa status untuk kode umum.
fungsi _http_frasa(kode) {
    jika kode == 200 { kembalikan "OK" }
    jika kode == 201 { kembalikan "Created" }
    jika kode == 204 { kembalikan "No Content" }
    jika kode == 400 { kembalikan "Bad Request" }
    jika kode == 401 { kembalikan "Unauthorized" }
    jika kode == 403 { kembalikan "Forbidden" }
    jika kode == 404 { kembalikan "Not Found" }
    jika kode == 405 { kembalikan "Method Not Allowed" }
    jika kode == 411 { kembalikan "Length Required" }
    jika kode == 413 { kembalikan "Content Too Large" }
    jika kode == 415 { kembalikan "Unsupported Media Type" }
    jika kode == 500 { kembalikan "Internal Server Error" }
    # Kode tak dikenal: frasa generik per kelas, JANGAN "OK" -- "413 OK"
    # membingungkan manusia maupun alat yang membaca baris status.
    jika kode >= 500 { kembalikan "Server Error" }
    jika kode >= 400 { kembalikan "Client Error" }
    jika kode >= 300 { kembalikan "Redirection" }
    jika kode >= 200 { kembalikan "OK" }
    kembalikan "Unknown"
}

# Bangun response HTTP lengkap sebagai string.
fungsi http_response(kode, tipe_konten, badan) {
    variabel r = "HTTP/1.1 " + ke_teks(kode) + " " + _http_frasa(kode) + "\r\n"
    r = r + "Content-Type: " + tipe_konten + "\r\n"
    # Content-Length menghitung BYTE: panjang() menghitung karakter, jadi
    # badan non-ASCII dulu terpotong di peramban dan curl.
    r = r + "Content-Length: " + ke_teks(_http_panjang_byte(badan)) + "\r\n"
    r = r + "Connection: close\r\n"
    r = r + "\r\n"
    r = r + badan
    kembalikan r
}

# Pintasan: response JSON.
fungsi http_response_json(kode, badan) {
    kembalikan http_response(kode, "application/json", badan)
}

# --- klien HTTP (http_ambil) -------------------------------------------------
# Padanan urllib.request.urlopen / requests.get untuk http:// saja (HTTPS
# butuh TLS dan belum ada). Permintaan dikirim sebagai HTTP/1.0: server tidak
# boleh membalasnya dengan "chunked", dan badan berakhir saat koneksi
# ditutup -- jadi tidak perlu menghitung byte di bahasa yang mengindeks
# teks per karakter. Ditolak (GalatIzin) di `indk --sandbox`.

kelas GalatJaringan < GalatOS {
    init(pesan) {
        diri.pesan = pesan
    }
}

# Hasil satu permintaan.
kelas Respons {
    init(url, status, alasan, kepala, badan) {
        diri.url = url
        diri.status = status
        diri.alasan = alasan
        diri.kepala = kepala      # kamus, nama header huruf kecil
        diri.badan = badan
    }

    # ok() -> benar untuk status 2xx.
    ok() {
        kembalikan diri.status >= 200 dan diri.status < 300
    }

    # periksa() -> GalatJaringan untuk status 4xx/5xx (raise_for_status).
    periksa() {
        jika diri.status >= 400 {
            naikkan GalatJaringan(f"{diri.status} {diri.alasan} untuk {diri.url}")
        }
        kembalikan diri
    }

    _teks_() {
        kembalikan f"<Respons {diri.status} {diri.alasan}>"
    }
}

# _http_panjang_byte(t) -> panjang teks dalam byte UTF-8 (Content-Length
# menghitung byte, panjang() menghitung karakter).
fungsi _http_panjang_byte(t) {
    variabel n = 0
    untuk c dalam t {
        variabel o = ord(c)
        jika o < 128 {
            n = n + 1
        } jika_lain o < 2048 {
            n = n + 2
        } jika_lain o < 65536 {
            n = n + 3
        } selain {
            n = n + 4
        }
    }
    kembalikan n
}

# _http_aman(t, apa, boleh_spasi) -- tolak CR/LF (dan spasi) yang bisa
# menyisipkan header atau baris permintaan kedua.
fungsi _http_aman(t, apa, boleh_spasi) {
    jika "\r" dalam t atau "\n" dalam t atau (tidak boleh_spasi dan " " dalam t) {
        naikkan GalatJaringan(f"{apa} memuat karakter terlarang: {repr(t)}")
    }
    kembalikan t
}

# http_urai_url(url) -> [host, port, jalur] untuk url http://.
fungsi http_urai_url(url) {
    jika jenis(url) != "teks" {
        naikkan GalatJaringan(f"url harus teks, bukan {jenis(url)}")
    }
    _http_aman(url, "url", salah)
    jika teks_mulai_dengan(huruf_kecil(url), "https://") {
        naikkan GalatJaringan("HTTPS belum didukung (butuh TLS); pakai http://")
    }
    jika tidak teks_mulai_dengan(huruf_kecil(url), "http://") {
        naikkan GalatJaringan(f"url harus diawali http://: {repr(url)}")
    }
    variabel sisa = url[7:]
    # Fragmen (#...) tidak pernah dikirim ke server.
    variabel pagar = teks_cari(sisa, "#")
    jika pagar != 0 - 1 {
        sisa = sisa[:pagar]
    }
    variabel garis = teks_cari(sisa, "/")
    variabel tanya = teks_cari(sisa, "?")
    jika tanya != 0 - 1 dan (garis == 0 - 1 atau tanya < garis) {
        garis = tanya
    }
    variabel alamat = sisa
    variabel jalur = "/"
    jika garis != 0 - 1 {
        alamat = sisa[:garis]
        jalur = sisa[garis:]
        jika jalur[0] == "?" {
            jalur = "/" + jalur
        }
    }
    jika "@" dalam alamat {
        naikkan GalatJaringan(f"url dengan nama pengguna belum didukung: {repr(url)}")
    }
    jika teks_mulai_dengan(alamat, "[") {
        naikkan GalatJaringan(f"alamat IPv6 dalam url belum didukung: {repr(url)}")
    }
    variabel host = alamat
    variabel port = 80
    variabel titik_dua = teks_cari(alamat, ":")
    jika titik_dua != 0 - 1 {
        host = alamat[:titik_dua]
        variabel angka = alamat[titik_dua + 1:]
        variabel sah = panjang(angka) > 0
        untuk c dalam angka {
            jika c < "0" atau c > "9" {
                sah = salah
            }
        }
        jika tidak sah {
            naikkan GalatJaringan(f"port tidak sah di url: {repr(url)}")
        }
        port = ke_angka(angka)
    }
    jika host == "" {
        naikkan GalatJaringan(f"url tanpa host: {repr(url)}")
    }
    kembalikan [host, port, jalur]
}

# _http_satu_permintaan(...) -> Respons untuk SATU permintaan, tanpa
# mengikuti pengalihan. Dipakai http_ambil() di bawah.
fungsi _http_satu_permintaan(url, metode = "GET", kepala = kosong, badan = "") {
    variabel bagian = http_urai_url(url)
    variabel host = bagian[0]
    variabel port = bagian[1]
    variabel host_kepala = host jika port == 80 selain host + ":" + ke_teks(port)
    _http_aman(metode, "metode", salah)
    variabel baris = [metode + " " + bagian[2] + " HTTP/1.0", "Host: " + host_kepala,
                      "User-Agent: Indonesiaku", "Connection: close"]
    jika kepala bukan adalah kosong {
        untuk nama dalam kepala {
            baris.tambah(_http_aman(ke_teks(nama), "nama header", salah) + ": "
                         + _http_aman(ke_teks(kepala[nama]), "nilai header", benar))
        }
    }
    jika badan != "" atau metode == "POST" atau metode == "PUT" atau metode == "PATCH" {
        baris.tambah("Content-Length: " + ke_teks(_http_panjang_byte(badan)))
    }
    variabel permintaan = teks_gabung(baris, "\r\n") + "\r\n\r\n" + badan

    variabel s = soket_sambung(host, port)
    variabel data = ""
    coba {
        soket_tulis(s, permintaan)
        selagi benar {
            variabel potongan = soket_baca(s)
            jika potongan == "" {
                hentikan
            }
            data = data + potongan
        }
    } akhirnya {
        soket_tutup(s)
    }

    variabel pemisah = teks_cari(data, "\r\n\r\n")
    jika pemisah == 0 - 1 {
        naikkan GalatJaringan(f"respons dari {url} tidak lengkap")
    }
    variabel baris_kepala = teks_pisah(data[:pemisah], "\r\n")
    variabel status = teks_pisah(baris_kepala[0], " ")
    jika panjang(status) < 2 atau tidak teks_mulai_dengan(status[0], "HTTP/") {
        naikkan GalatJaringan(f"baris status tidak sah dari {url}: {repr(baris_kepala[0])}")
    }
    variabel alasan = teks_gabung(status[2:], " ")
    variabel hasil_kepala = kamus()
    untuk b dalam baris_kepala[1:] {
        variabel h = _http_pisah_header(b)
        jika h[0] != "" {
            hasil_kepala[huruf_kecil(h[0])] = h[1]
        }
    }
    variabel kode = status[1]
    jika panjang(kode) != 3 atau tidak semua([c >= "0" dan c <= "9" untuk c dalam kode]) {
        naikkan GalatJaringan(f"kode status tidak sah dari {url}: {repr(kode)}")
    }
    kembalikan Respons(url, ke_bulat(kode), alasan, hasil_kepala, data[pemisah + 4:])
}

# _http_gabung_url(dasar, lokasi) -> URL absolut.
# Header Location boleh absolut ("http://lain.id/x"), berakar ("/x"), atau
# relatif ("x"). Dua bentuk terakhir diselesaikan terhadap URL sebelumnya.
fungsi _http_gabung_url(dasar, lokasi) {
    jika lokasi == "" {
        naikkan GalatJaringan(f"header Location kosong pada {dasar}")
    }
    # Absolut: biarkan http_urai_url() yang menilai skemanya.
    jika "://" dalam lokasi {
        kembalikan lokasi
    }
    variabel bagian = http_urai_url(dasar)
    variabel host = bagian[0]
    variabel port = bagian[1]
    variabel awal = "http://" + host
    jika port != 80 {
        awal = awal + ":" + ke_teks(port)
    }
    jika teks_mulai_dengan(lokasi, "/") {
        kembalikan awal + lokasi
    }
    # Relatif: ganti segmen terakhir jalur sebelumnya.
    variabel jalur = bagian[2]
    variabel tanya = teks_cari(jalur, "?")
    jika tanya != 0 - 1 {
        jalur = jalur[:tanya]
    }
    variabel potong = 0 - 1
    variabel i = 0
    untuk c dalam jalur {
        jika c == "/" {
            potong = i
        }
        i = i + 1
    }
    kembalikan awal + jalur[:potong + 1] + lokasi
}

# http_ambil(url, metode, kepala, badan, maks_pengalihan) -> Respons.
# Status 4xx/5xx BUKAN galat (pakai .periksa()); host tidak ditemukan atau
# koneksi ditolak adalah GalatOS dari soket_sambung.
#
# Pengalihan 301/302/303/307/308 diikuti sampai maks_pengalihan lompatan
# (bawaan 5). Beri 0 untuk menerima respons pengalihan apa adanya.
# .url pada hasil berisi URL TERAKHIR, bukan url yang diminta.
fungsi http_ambil(url, metode = "GET", kepala = kosong, badan = "", maks_pengalihan = 5) {
    jika jenis(maks_pengalihan) != "angka" atau maks_pengalihan < 0 atau maks_pengalihan != lantai(maks_pengalihan) {
        naikkan GalatJaringan("maks_pengalihan harus bilangan bulat >= 0")
    }
    variabel kini = url
    variabel m = metode
    variabel b = badan
    variabel dikunjungi = [url]
    variabel lompatan = 0

    selagi benar {
        variabel r = _http_satu_permintaan(kini, m, kepala, b)
        jika r.status < 300 atau r.status > 399 {
            kembalikan r
        }
        variabel dialihkan = r.status == 301 atau r.status == 302 atau r.status == 303 atau r.status == 307 atau r.status == 308
        jika tidak dialihkan {
            kembalikan r      # 304 Not Modified dan kerabatnya: bukan pengalihan
        }
        jika tidak "location" dalam r.kepala {
            kembalikan r      # server melanggar spesifikasi; tampilkan apa adanya
        }
        jika lompatan >= maks_pengalihan {
            jika maks_pengalihan == 0 {
                kembalikan r
            }
            naikkan GalatJaringan(
                f"pengalihan melebihi {maks_pengalihan} lompatan: " +
                teks_gabung(dikunjungi, " -> "))
        }

        variabel tujuan = _http_gabung_url(kini, teks_pangkas(r.kepala["location"]))
        jika tujuan dalam dikunjungi {
            naikkan GalatJaringan(
                f"pengalihan berputar: " + teks_gabung(dikunjungi, " -> ") +
                f" -> {tujuan}")
        }
        # 303 berarti "lihat di sini", selalu diambil dengan GET.
        # 301/302 sengaja mempertahankan metode: peramban mengubahnya jadi GET,
        # tetapi itu kekeliruan historis yang justru melahirkan 307/308.
        jika r.status == 303 {
            m = "GET"
            b = ""
        }
        dikunjungi.tambah(tujuan)
        kini = tujuan
        lompatan = lompatan + 1
    }
}
